  secondOffenseFee Float          @default(0)
  thirdOffenseFee  Float          @default(0)
  remarks          String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  details          TicketDetail[]
}

model TicketPhoto {
  id             String       @id @default(cuid())
  ticketHeaderId String
  photoUrl       String
  createdAt      DateTime     @default(now())
  ticketHeader   TicketHeader @relation(fields: [ticketHeaderId], references: [id], onDelete: Cascade)

  @@index([ticketHeaderId])
}

model TicketHeader {
  id              String         @id @default(cuid())
  ticketNo        String         @unique
  localId         Int?
  deviceId        String?
  violatorName    String
  violatorAddress String?
  birthDate       String?
  licenseNo       String?
  licenseImage    String?
  plateNo         String?
  ownerName       String?
  typeOfVehicle   String?
  puvBodyName     String?
  puvBodyNo       String?
  location        String?
  barangay        String?
  dateTime        DateTime       @default(now())
  officerName     String?
  badgeNo         String?
  officerUserId   String?
  totalAmount     Float          @default(0)
  status          TicketStatus   @default(ISSUED)
  isPaid          Boolean        @default(false)
  remarks         String?
  driverSignature String?
  transactionId   String?
  syncedAt        DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  impoundFee      Float          @default(0)
