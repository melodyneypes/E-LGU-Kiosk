generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  emailVerified         DateTime?
  password              String?
  role                  UserRole          @default(USER)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  isEmailVerified       Boolean           @default(false)
  isPasswordChanged     Boolean           @default(false)
  rejectionCount        Int               @default(0)
  rejectionResetAt      DateTime?
  managedBarangay       String?
  department            String?
  accessiblePages       String[]          @default([])
  accessibleCategories  String[]          @default([])
  accessibleStatuses    String[]          @default([])
  isSynced              Boolean           @default(false)
  rfid                  String?           @unique
  consecutiveRejections Json?             @default("{}")
  fcmToken              String?
  accounts              Account[]
  reports               Report[]
  residentProfile       Resident?
  reviews               Review[]
  sessions              Session[]
  vendorStalls          Stall[]           @relation("VendorStalls")
  collectorCollections  StallCollection[] @relation("CollectorCollections")
  vendorCollections     StallCollection[] @relation("VendorCollections")
  driverTransactions    Transaction[]     @relation("DriverTransactions")
  transactions          Transaction[]     @relation("ResidentTransactions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dining {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String
  cuisineType   String?
  openingHours  String?
  contactNumber String?
  facebookUrl   String?
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  barangay      String?
  reviews       Review[]
}

model Accommodation {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String
  type          String
  priceRange    String?
  amenities     String?
  contactNumber String?
  websiteUrl    String?
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  barangay      String?
  reviews       Review[]
}

model TourismSpot {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String?
  address         String
  entranceFee     String?
  bestTimeToVisit String?
  contactNumber   String?
  imageUrl        String?
  latitude        Float?
  longitude       Float?
  googleMapsUrl   String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  barangay        String?
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String
  startDate     DateTime
  endDate       DateTime
  venueName     String
  address       String
  contactNumber String?
  imageUrl      String?
  reminders     String[] @default([])
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  barangay      String?
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  author      String?
  category    String   @default("Announcement")
  imageUrl    String?
  publishDate DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  barangay    String?
}

model Announcement {
  id             String    @id @default(cuid())
  title          String
  content        String
  priority       String    @default("Normal")
  category       String    @default("General")
  isPinned       Boolean   @default(false)
  isActive       Boolean   @default(true)
  expiryDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  barangay       String?
  imageUrl       String?
  authorEmail    String?
  authorId       String?
  healthCenterId String?
  eventDate      DateTime?
  eventSchedule  String?
}

model Job {
  id             String    @id @default(cuid())
  title          String
  department     String
  description    String
  qualifications String
  requirements   String
  salary         String?
  employmentType String
  deadline       DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  links          Json?     @default("[]")
  location       String?
  mapUrl         String?
  barangay       String?
}

model Official {
  id            String    @id @default(cuid())
  name          String
  position      String
  contactNumber String?
  bio           String?
  imageUrl      String?
  termStart     DateTime?
  termEnd       DateTime?
  order         Int       @default(99)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  achievements  String?
  education     String?
  email         String?
  links         Json?     @default("[]")
  motto         String?
  barangay      String?
  category      String    @default("LGU")
}

model Hotline {
  id           String   @id @default(cuid())
  name         String
  category     String
  mobileNumber String?
  telephone    String?
  address      String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String
  status      String
  location    String
  budget      String?
  contractor  String?
  startDate   DateTime?
  endDate     DateTime?
  progress    Int       @default(0)
  imageUrl    String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barangay    String?
}

model Household {
  id            String     @id @default(cuid())
  headId        String?    @unique
  barangay      String
  latitude      Float?
  longitude     Float?
  householdSize Int        @default(1)
  contactNumber String?
  riskLevel     String     @default("Safe")
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  head          Resident?  @relation("HouseholdHead", fields: [headId], references: [id])
  members       Resident[] @relation("HouseholdMembers")
}

model Resident {
  id                    String            @id @default(cuid())
  userId                String?           @unique
  firstName             String
  lastName              String
  middleName            String?
  suffix                String?
  gender                String
  dateOfBirth           DateTime
  age                   Int?
  placeOfBirth          String?
  civilStatus           String
  citizenship           String            @default("Filipino")
  height                String?
  weight                String?
  religion              String?
  bloodType             String?
  houseNumber           String?
  street                String?
  sitio                 String?
  purok                 String?
  barangay              String
  municipality          String            @default("")
  province              String            @default("")
  contactNumber         String?
  email                 String?
  isHead                Boolean           @default(false)
  relationshipToHead    String?
  householdId           String?
  tin                   String?
  gsis                  String?
  sss                   String?
  philhealthNumber      String?
  occupation            String?
  employer              String?
  motherFirstName       String?
  motherMiddleName      String?
  motherLastName        String?
  fatherFirstName       String?
  fatherMiddleName      String?
  fatherLastName        String?
  idType                String?
  idFrontUrl            String?
  idBackUrl             String?
  livenessUrl           String?
  educationalAttainment String?
  degreeProgram         String?
  employmentStatus      String?
  monthlyIncome         String?
  isSenior              Boolean           @default(false)
  isPWD                 Boolean           @default(false)
  isSoloParent          Boolean           @default(false)
  isIndigenous          Boolean           @default(false)
  is4Ps                 Boolean           @default(false)
  otherSector           String?
  dataPrivacyConsent    Boolean           @default(false)
  consentTimestamp      DateTime?
  receivedBy            String?
  officialPosition      String?
  dateReceived          DateTime?
  imageUrl              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  facialRecognition     Json?
  isDead                Boolean           @default(false)
  isSynced              Boolean           @default(false)
  registrationStatus    ResidentStatus    @default(PENDING)
  registrationType      String?           @default("SELF")
  rfid                  String?           @unique
  familyHeadId          String?
  latitude              Float?
  longitude             Float?
  categoryId            String?
  rejectionRemarks      String?
  reviewedAt            DateTime?
  reviewedBy            String?
  ownedHousehold        Household?        @relation("HouseholdHead")
  category              ResidentCategory? @relation("ResidentCategory", fields: [categoryId], references: [id])
  familyHead            Resident?         @relation("FamilyLink", fields: [familyHeadId], references: [id])
  familyMembers         Resident[]        @relation("FamilyLink")
  household             Household?        @relation("HouseholdMembers", fields: [householdId], references: [id])
  user                  User?             @relation(fields: [userId], references: [id])

  @@index([barangay])
  @@index([registrationStatus])
  @@index([lastName, firstName])
  @@index([categoryId])
  @@index([isSenior])
  @@index([isPWD])
  @@index([isSoloParent])
  @@index([isDead])
  @@index([createdAt])
}

model DisasterMap {
  id          String         @id @default(cuid())
  title       String
  location    String?
  description String?
  imagePath   String?
  riskLevel   String?
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  zones       DisasterZone[]
}

model DisasterZone {
  id            String       @id @default(cuid())
  disasterMapId String?
  type          String
  typeColor     String
  riskLevel     String
  riskColor     String
  shapes        Json         @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  disasterMap   DisasterMap? @relation(fields: [disasterMapId], references: [id])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id               String   @id @default(cuid())
  title            String
  subtitle         String?
  tagline          String?
  imageUrl         String
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  primaryBtnText   String?
  primaryBtnLink   String?
  secondaryBtnText String?
  secondaryBtnLink String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barangay         String?
}

model ResidentCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  residents   Resident[] @relation("ResidentCategory")
}

model Report {
  id           String        @id @default(cuid())
  userId       String
  category     String
  description  String
  status       ReportStatus  @default(PENDING)
  images       String[]      @default([])
  latitude     Float?
  longitude    Float?
  address      String?
  adminComment String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barangayId   String?
  barangay     BarangayInfo? @relation(fields: [barangayId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([barangayId])
}

model AboutPage {
  id                      String   @id @default(cuid())
  history                 String
  mission                 String
  vision                  String
  coreValues              String
  mayorName               String   @default("")
  mayorMessage            String
  mayorImageUrl           String?
  geographyOrDemographics String?
  coverImages             Json?    @default("[]")
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

model PastMayor {
  id          String   @id @default(cuid())
  name        String
  termStart   String
  termEnd     String
  imageUrl    String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  barangay    String?
}

model ChurchInfo {
  id          String             @id @default(cuid())
  name        String
  address     String?
  locationUrl String?
  flyerUrl    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  latitude    Float?
  longitude   Float?
  barangay    String?
  collections ChurchCollection[]
  schedules   ChurchSchedule[]
}

model ChurchSchedule {
  id           String     @id @default(cuid())
  churchInfoId String
  day          String
  time         String
  language     String?
  type         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  date         DateTime?
  description  String?
  prio         Int        @default(0)
  churchInfo   ChurchInfo @relation(fields: [churchInfoId], references: [id], onDelete: Cascade)
}

model ChurchCollection {
  id             String      @id @default(cuid())
  date           DateTime    @default(now())
  sundayMassJson Json?
  secondBasket   Float       @default(0)
  weekdays       Float       @default(0)
  envelopes      Float       @default(0)
  donationsJson  Json?
  totalAmount    Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  churchInfoId   String?
  churchInfo     ChurchInfo? @relation(fields: [churchInfoId], references: [id], onDelete: Cascade)
}

model BarangayInfo {
  id                      String   @id @default(cuid())
  name                    String   @unique
  description             String?
  logoUrl                 String?
  coverImageUrl           String?
  captainName             String?
  captainMessage          String?
  captainImageUrl         String?
  history                 String?
  mission                 String?
  vision                  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  coreValues              String?
  coverImages             Json?    @default("[]")
  geographyOrDemographics String?
  deliveryFee             Float    @default(0)
  isLogisticsActive       Boolean  @default(true)
  estimatedDeliveryDays   Int      @default(3)
  reports                 Report[]
}

model TransactionType {
  id                   String        @id @default(cuid())
  code                 String        @unique
  name                 String
  description          String?
  level                Int           @default(1)
  category             String
  baseFee              Float         @default(0)
  deliveryFee          Float         @default(0)
  isFixed              Boolean       @default(true)
  requiresBusinessName Boolean       @default(false)
  supportsECopy        Boolean       @default(false)
  requiredDocs         Json          @default("[]")
  formSchema           Json          @default("{}")
  logicCode            String?
  defaultFees          Json          @default("[]")
  slaDays              Int           @default(3)
  processorRole        UserRole      @default(TREASURY_STAFF)
  isActive             Boolean       @default(true)
  studentFee           Float?        @default(0)
  lateFee              Float?        @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  pickupAddress        String?
  processingTime       String?
  transactions         Transaction[]
}

model Transaction {
  id                            String                         @id @default(cuid())
  userId                        String?
  driverId                      String?
  typeId                        String
  status                        TransactionStatus              @default(DRAFT)
  residentSnapshot              Json
  additionalData                Json
  fulfillmentType               FulfillmentType?
  deliveryAddress               Json?
  deliveryLat                   Float?
  deliveryLng                   Float?
  deliveryLandmark              String?
  paymentType                   PaymentType?
  paymentReference              String?
  totalAmount                   Float                          @default(0)
  fiscalSnapshot                Json?
  revisionCount                 Int                            @default(0)
  businessName                  String?
  eCopyUrl                      String?
  orUrl                         String?
  isStudent                     Boolean                        @default(false)
  processedBy                   String?
  rejectionRemarks              String?
  podUrl                        String?
  podData                       Json?
  inRouteAt                     DateTime?
  deliveredAt                   DateTime?
  disputeReason                 String?
  disputeRemarks                String?
  disputeProofUrl               String?
  isCancelled                   Boolean                        @default(false)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  appointmentDate               DateTime?
  appointmentSlot               String?
  isPaid                        Boolean                        @default(false)
  isPriority                    Boolean                        @default(false)
  queueNumber                   String?                        @unique
  birthCertificateRegistry      BirthCertificateRegistry?
  birthCertificateRequest       BirthCertificateRequest?
  birthPsaEndorsementRequest    BirthPsaEndorsementRequest?
  buildingPermit                BuildingPermit?
  businessPermit                BusinessPermit?
  cedula                        Cedula?
  deathCertificateRequest       DeathCertificateRequest?
  deathPsaEndorsementRequest    DeathPsaEndorsementRequest?
  deathRegistration             DeathRegistration?
  marriageCertificateRequest    MarriageCertificateRequest?
  marriageLicenseApplication    MarriageLicenseApplication?
  marriagePsaEndorsementRequest MarriagePsaEndorsementRequest?
  marriageRegistration          MarriageRegistration?
  occupancyPermit               OccupancyPermit?
  payment                       Payment?
  ticketHeaders                 TicketHeader[]
  driver                        User?                          @relation("DriverTransactions", fields: [driverId], references: [id])
  type                          TransactionType                @relation(fields: [typeId], references: [id])
  user                          User?                          @relation("ResidentTransactions", fields: [userId], references: [id])

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([typeId])
  @@index([createdAt])
  @@index([appointmentDate])
  @@index([appointmentDate, appointmentSlot])
}

model Cedula {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  ctcNumber      String?     @unique
  taxYear        Int
  dateIssued     DateTime    @default(now())
  expiryDate     DateTime
  basicTax       Float
  additionalTax  Float
  penalty        Float
  totalPaid      Float
  businessName   String?
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model DeathRegistration {
  id             String       @id @default(cuid())
  transactionId  String?      @unique
  registryNumber String?      @unique
  dateOfEvent    DateTime?
  placeOfEvent   String?
  subjectName    String?
  fatherName     String?
  motherName     String?
  documentUrl    String?
  issuedBy       String?
  verificationId String       @unique @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model MarriageRegistration {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  ctcNumber      String?     @unique
  taxYear        Int
  dateIssued     DateTime    @default(now())
  expiryDate     DateTime
  basicTax       Float
  additionalTax  Float
  penalty        Float
  totalPaid      Float
  businessName   String?
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model MarriageLicenseApplication {
  id              String      @id @default(cuid())
  transactionId   String      @unique
  registryNumber  String?     @unique
  dateIssued      DateTime    @default(now())
  expiryDate      DateTime?
  app1FullName    String
  app1BirthDate   DateTime?
  app1BirthPlace  String?
  app1Citizenship String?
  app2FullName    String
  app2BirthDate   DateTime?
  app2BirthPlace  String?
  app2Citizenship String?
  documentUrl     String?
  issuedBy        String
  verificationId  String      @unique @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model BusinessPermit {
  id                String      @id @default(cuid())
  transactionId     String      @unique
  permitNumber      String
  taxYear           Int
  dateIssued        DateTime    @default(now())
  expiryDate        DateTime
  businessName      String
  tradeName         String?
  orgType           String
  dtiSecNumber      String?
  lineOfBusiness    String
  capitalInvestment Float
  grossSales        Float       @default(0)
  employeeCount     Int         @default(1)
  businessArea      Float?
  documentUrl       String?
  stickerNumber     String?
  issuedBy          String
  verificationId    String      @unique @default(cuid())
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model BuildingPermit {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  permitNumber   String      @unique
  dateIssued     DateTime    @default(now())
  applicantName  String
  projectType    String
  occupancyUse   String
  location       String?
  estimatedCost  Float
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model OccupancyPermit {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  permitNumber   String      @unique
  dateIssued     DateTime    @default(now())
  applicantName  String
  projectType    String
  occupancyUse   String
  location       String?
  estimatedCost  Float
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model BirthCertificateRequest {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  registryNumber String?     @unique
  dateIssued     DateTime    @default(now())
  subjectName    String
  subjectName2   String?
  dateOfEvent    DateTime
  placeOfEvent   String
  fatherName     String?
  motherName     String?
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model DeathCertificateRequest {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  registryNumber String?     @unique
  dateIssued     DateTime    @default(now())
  subjectName    String
  dateOfEvent    DateTime
  placeOfEvent   String
  fatherName     String?
  motherName     String?
  documentUrl    String?
  issuedBy       String?
  verificationId String      @unique @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model MarriageCertificateRequest {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  registryNumber String?     @unique
  dateIssued     DateTime    @default(now())
  subjectName    String
  spouseName     String
  dateOfEvent    DateTime
  placeOfEvent   String
  documentUrl    String?
  issuedBy       String
  verificationId String      @unique @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model MarriagePsaEndorsementRequest {
  id                   String      @id @default(cuid())
  transactionId        String      @unique
  registryNumber       String?     @unique
  dateIssued           DateTime    @default(now())
  husbandFullName      String
  wifeFullName         String
  dateOfMarriage       DateTime
  placeOfMarriage      String
  relationship         String
  contactNumber        String
  email                String?
  informantFirstName   String
  informantMiddleName  String?
  informantLastName    String
  informantSuffix      String?
  informantBirthDate   DateTime?
  informantAge         Int?
  informantCivilStatus String?
  informantCitizenship String?
  informantOccupation  String?
  informantAddress     String?
  psaNegativeCert      String
  form3a               String
  documentUrl          String?
  issuedBy             String?
  verificationId       String      @unique @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model BirthPsaEndorsementRequest {
