  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StallType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  stalls      Stall[]
}

model StallOtherFee {
  id        String            @id @default(cuid())
  stallId   String
  amount    Float             @default(0)
  createdAt DateTime          @default(now())
  createdBy String?
  feeType   StallFeeFrequency @default(DAILY)
  name      String
  remarks   String?
  updatedAt DateTime          @updatedAt
  updatedBy String?
  stall     Stall             @relation(fields: [stallId], references: [id], onDelete: Cascade)
}

model Stall {
  id                    String            @id @default(cuid())
  stallTypeId           String
  stallNumber           String            @unique
  vendorId              String?
  status                StallStatus       @default(VACANT)
  dailyRate             Float             @default(0)
  monthlyRate           Float             @default(0)
  dailyRateOverdueFee   Float             @default(0)
  monthlyRateOverdueFee Float             @default(0)
  createdAt             DateTime          @default(now())
  createdBy             String?
  updatedAt             DateTime          @updatedAt
  updatedBy             String?
  stallType             StallType         @relation(fields: [stallTypeId], references: [id])
  vendor                User?             @relation("VendorStalls", fields: [vendorId], references: [id])
  collections           StallCollection[]
  otherFees             StallOtherFee[]
}

model StallCollection {
  id              String             @id @default(cuid())
  stallId         String
  vendorId        String?
  collectorId     String
  collectedDate   DateTime           @default(now())
  ticketNumber    String             @unique
  baseAmount      Float              @default(0)
  otherFeesPaid   Float              @default(0)
  overdueFeePaid  Float              @default(0)
  totalAmountPaid Float              @default(0)
  paymentMethod   StallPaymentMethod @default(CASH)
  status          CollectionStatus   @default(PAID)
  remarks         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  collector       User               @relation("CollectorCollections", fields: [collectorId], references: [id])
  stall           Stall              @relation(fields: [stallId], references: [id])
  vendor          User?              @relation("VendorCollections", fields: [vendorId], references: [id])
}

