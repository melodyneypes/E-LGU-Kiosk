  @@index([transactionId])
}

model TicketDetail {
  id             String            @id @default(cuid())
  ticketHeaderId String
  violationId    String?
  violationName  String
  offenseLevel   Int               @default(1)
  amount         Float             @default(0)
  createdAt      DateTime          @default(now())
  header         TicketHeader      @relation(fields: [ticketHeaderId], references: [id], onDelete: Cascade)
  violation      TrafficViolation? @relation(fields: [violationId], references: [id])
}

model VehicleClassification {
  id          String   @id @default(cuid())
  code        String   @unique
  className   String
  description String?
  impoundFee  Float    @default(0)
