model Payment {
  id            String        @id @default(cuid())
  transactionId String        @unique
  amount        Float         @default(0)
  method        PaymentType   @default(CASH)
  status        PaymentStatus @default(PENDING)
  reference     String?
  meta          Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orNumber      String?
  userId        String?
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Review {
  id              String         @id @default(cuid())
  rating          Int
  comment         String?
  mediaUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  accommodationId String?
  diningId        String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  dining          Dining?        @relation(fields: [diningId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accommodationId])
  @@index([diningId])
}

model AppointmentConfig {
  id            String   @id @default(cuid())
  department    String   @unique
  maxSlots      Int      @default(50)
  maxSlotsAM    Int      @default(25)
  maxSlotsPM    Int      @default(25)
  blockedDates  String[] @default([])
  activeDays    Int[]    @default([1, 2, 3, 4, 5])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  amTimeLabel   String   @default("08:00 AM - 11:00 AM")
  pmTimeLabel   String   @default("01:00 PM - 04:00 PM")
  specialEvents Json?    @default("[]")
}

model RHUInventoryItem {
  id             String              @id @default(cuid())
  name           String
  genericName    String?
  brandName      String?
  category       InventoryCategory   @default(MEDICINE)
  dosage         String?
  unit           String              @default("pcs")
  quantity       Int                 @default(0)
  reorderLevel   Int                 @default(10)
  expirationDate DateTime?
  batchNumber    String?
  remarks        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  healthCenterId String?
  batches        RHUInventoryBatch[]

  @@index([category])
  @@index([name])
}

model RHUInventoryBatch {
  id              String           @id @default(cuid())
  itemId          String
  batchNumber     String
  expirationDate  DateTime?
  quantity        Int              @default(0)
  initialQuantity Int              @default(0)
  receivedDate    DateTime         @default(now())
  remarks         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  healthCenterId  String?
  item            RHUInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([batchNumber])
  @@index([expirationDate])
  @@index([healthCenterId])
}

model RHUHealthCenter {
  id              String                @id @default(cuid())
  name            String
  code            String?
  location        String
  latitude        Float?
  longitude       Float?
  barangay        String?
  contactNumber   String?
  operatingHours  String?               @default("Mon-Fri 8:00 AM - 5:00 PM")
  headPersonnel   String?
  servicesOffered String?
  status          String                @default("ACTIVE")
  remarks         String?
  userId          String?
  accountEmail    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  pharmacyEmail   String?
  pharmacyUserId  String?
  personnel       RHUMedicalPersonnel[]

  @@index([name])
  @@index([barangay])
  @@index([status])
}

model RHUMedicalPersonnel {
  id               String           @id @default(cuid())
  name             String
  role             MedicalRole      @default(DOCTOR)
  specialization   String?
  licenseNumber    String?
  contactNumber    String?
  email            String?
  schedule         String?          @default("Mon-Fri 8:00 AM - 5:00 PM")
  assignedServices String?
  status           String           @default("ACTIVE")
  healthCenterId   String?
  userId           String?
  accountEmail     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
